1 _META <metadataxml><content><line>&lt;span style="font-family: georgia; font-size: 16px"&gt;&lt;span style="color: #000000"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: #000000"&gt;Hildebrand Stael von Holstein &amp;nbsp;f&amp;ouml;dde
2 CONC s omkring 1535 och arbetade som pantherre till&amp;nbsp;&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&a
2 CONC mp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Pelbag&amp;nbsp;i Livland. Den tyska, eller Livl&amp;auml;ndska ordensstatens uppl&amp;ouml;sning vid mitten av 1500-talet&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbs
2 CONC p;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; hade&amp;nbsp;f&amp;ouml;r&amp;auml
2 CONC ;ndrat situationen i Livland. En intensiv kamp utl&amp;ouml;stes mellan Polen, Ryssland, Sverige,&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&
2 CONC amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Danmark och L&amp;uuml;beck (Hansan) om det tomrum som uppstod. 1557 i staden Pozwol ingick den&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&am
2 CONC p;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;livl&amp;auml;ndska konfederat
2 CONC ionen en pakt med Kung Sigismund II av Polen-Livland. 1558 anf&amp;ouml;lls&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&am
2 CONC p;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Livland&amp;nbsp;&amp;ouml;sterifr&amp;aring;n av Ivan den IV &amp;quot;den f&amp;ouml;rskr&amp;auml;cklige&amp;quot; vilket betydde starten f&amp;ouml;r det&am
2 CONC p;nbsp;Livl&amp;auml;ndska&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&a
2 CONC mp;nbsp;&amp;nbsp;&amp;nbsp; Livl&amp;auml;nska kriget (1558-1583). Hildebrand tillh&amp;ouml;rde under kriget den polska armen och&amp;nbsp;avancerade&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: #000000"&gt;&amp;nbsp;&am
2 CONC p;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; till&amp;nbsp;major
2 CONC . 1580 tillf&amp;aring;ngatogs han och placerades i f&amp;auml;ngelse i Moskva. Han sl&amp;auml;pptes&amp;nbsp;1587 och dog&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;
2 CONC nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; strax efter.&lt;/span&gt;&lt;/span&gt;</line></content></metadataxml>
