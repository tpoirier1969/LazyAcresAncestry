1 _META <metadataxml><content><line>&lt;span style="font-family: georgia; font-size: 16px"&gt;&lt;span style="font-size: 12pt"&gt;&amp;nbsp;Johan Sta&amp;euml;l von Holstein f&amp;ouml;ddes 1636 i Livland som d&amp;aring; tillh&amp;ouml;rde Sverige. Sin mi
2 CONC lit&amp;auml;ra bana&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbs
2 CONC p;&amp;nbsp;&amp;nbsp;&amp;nbsp;inom kungliga svenska armen p&amp;aring;b&amp;ouml;rjade han 1651. Den 14 oktober 1652 naturaliserades han&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;
2 CONC &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; tillsammans med sin br&amp;ouml;der och kusiner som svensk adelsman av drottning Kristina.&amp;nbsp;De&amp;nbsp;&lt;b
2 CONC r&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; introducerad
2 CONC es&amp;nbsp;vid det svenska riddarhuset den 20 september 1675 under namnet&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp
2 CONC ;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Sta&amp;euml;l von Holstein nr: 834.&amp;nbsp; Johan utn&amp;auml;mndes 1658 till generalkvarterm&amp;auml;stare vid svenska armen&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&
2 CONC amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;i Danmark. Den 6 september&am
2 CONC p;nbsp;1660 avancerade han till major vid artilleriarbetet i Ingermanland.&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp
2 CONC ;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;Han gifte sig 1664 med Christina&amp;nbsp; M&amp;ouml;ller. Den 15 september 1673 utn&amp;auml;mndes han till&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&a
2 CONC mp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;ouml;verstel&amp;ouml;jtnant&amp;nbsp;&lt;/span&gt;&lt;span styl
2 CONC e="font-size: 12pt"&gt;vid artilleriet i Finland. Under&amp;nbsp;sin tid i Estland och Ingermanland arbetade&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;
2 CONC &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Johan som inspektor &amp;ouml;ver fortifikationsarbetet i Estland&amp;nbsp;och&amp;nbsp;Ingermanland. Bland annat borgen&amp;nbsp;&lt;br&gt;&amp;nb
2 CONC sp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Nyenschanz som l&amp;aring;g d&amp
2 CONC ;auml;r Sankt Petersburg ligger idag.&amp;nbsp;Johan Sta&amp;euml;l von&amp;nbsp;Holstein &amp;auml;gde godsen&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbs
2 CONC p;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Wasahof, Goldina i Waiwara socken&amp;nbsp;&lt;/span&gt;i Estland och Liliehagen&amp;nbsp;i Gregorii socken i Koporie l&amp;auml;n samt&amp;nbsp;
2 CONC &lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Duderhof i Gregori socke
